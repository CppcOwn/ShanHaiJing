/* detail.wxss */
.detail-header {
  position: relative;
  height: 400rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.detail-header-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.detail-header-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
  padding: 40rpx 20rpx;
  color: #fff;
}

.detail-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.detail-subtitle {
  font-size: 24rpx;
  opacity: 0.9;
}

.detail-content {
  padding: 0 20rpx 40rpx;
}

.detail-section {
  margin-bottom: 30rpx;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.detail-section-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 15rpx;
  color: #333;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-section-content {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.info-item {
  display: flex;
  margin-bottom: 15rpx;
  align-items: flex-start;
}

.info-label {
  width: 120rpx;
  font-size: 22rpx;
  color: #999;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 22rpx;
  color: #333;
  line-height: 1.4;
}

.info-value navigator {
  color: #1890ff;
  text-decoration: underline;
}

.observation-points {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.observation-point-item {
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 15rpx;
}

.observation-point-name {
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  color: #333;
}

.observation-point-description {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.observation-point-facilities {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 10rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.observation-point-facilities-label {
  font-weight: bold;
  margin-right: 10rpx;
}

.observation-point-facilities-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.observation-point-facility {
  background-color: #e6f7ff;
  padding: 5rpx 10rpx;
  border-radius: 15rpx;
  font-size: 20rpx;
  color: #1890ff;
}

.observation-point-access {
  font-size: 22rpx;
  color: #666;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.observation-point-access-label {
  font-weight: bold;
  margin-right: 10rpx;
}

.weather-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background-color: #f0f8ff;
  padding: 20rpx;
  border-radius: 8rpx;
}

.weather-info-icon {
  font-size: 64rpx;
}

.weather-info-content {
  flex: 1;
}

.weather-info-temp {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
}

.weather-info-desc {
  font-size: 24rpx;
  color: #666;
}

.related-spots {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 15rpx;
}

.related-spot-item {
  background-color: #f5f5f5;
  border-radius: 8rpx;
  overflow: hidden;
  transition: all 0.3s ease;
}

.related-spot-item:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.related-spot-item navigator {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.related-spot-image {
  width: 100%;
  height: 150rpx;
  object-fit: cover;
  margin-bottom: 10rpx;
}

.related-spot-name {
  font-size: 22rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
  padding: 0 10rpx;
}

.related-spot-location {
  font-size: 20rpx;
  color: #999;
  padding: 0 10rpx 10rpx;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200rpx;
  font-size: 24rpx;
  color: #999;
}

.error {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200rpx;
  font-size: 24rpx;
  color: #ff4d4f;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .detail-header {
    height: 300rpx;
  }
  
  .detail-title {
    font-size: 32rpx;
  }
  
  .detail-subtitle {
    font-size: 20rpx;
  }
  
  .detail-section-title {
    font-size: 26rpx;
  }
  
  .detail-section-content {
    font-size: 22rpx;
  }
  
  .info-label {
    width: 100rpx;
    font-size: 20rpx;
  }
  
  .info-value {
    font-size: 20rpx;
  }
  
  .related-spots {
    grid-template-columns: 1fr;
  }
  
  .related-spot-image {
    height: 200rpx;
  }
}