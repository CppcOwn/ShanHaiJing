/* index.wxss */
.search-bar {
  margin-bottom: 20rpx;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 30rpx;
  padding: 15rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
  color: #999;
}

.search-placeholder {
  font-size: 24rpx;
  color: #999;
}

.swiper {
  height: 300rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.swiper-image {
  width: 100%;
  height: 300rpx;
}

.swiper-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
  padding: 30rpx 20rpx;
  color: #fff;
}

.swiper-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.swiper-subtitle {
  font-size: 20rpx;
  opacity: 0.9;
}

.card-content-wrapper {
  display: flex;
  gap: 20rpx;
}

.card-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.card-subtitle {
  font-size: 20rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.card-description {
  font-size: 22rpx;
  color: #666;
  line-height: 1.4;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 20rpx;
}

.card-rating {
  color: #ff9500;
  font-weight: bold;
}

.card-ticket {
  color: #1890ff;
}

.weather-preview {
  background-color: #f0f8ff;
  border-radius: 12rpx;
  padding: 20rpx;
}

.weather-preview-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.weather-icon {
  font-size: 64rpx;
  margin-right: 20rpx;
}

.weather-info {
  flex: 1;
}

.weather-temp {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
}

.weather-desc {
  font-size: 24rpx;
  color: #666;
}

.weather-arrow {
  font-size: 28rpx;
  color: #999;
}

.map-entry {
  display: block;
  background-color: #e6f7ff;
  border-radius: 12rpx;
  padding: 30rpx;
  text-align: center;
  transition: all 0.3s ease;
}

.map-entry:hover {
  background-color: #bae7ff;
}

.map-entry-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15rpx;
}

.map-icon {
  font-size: 64rpx;
}

.map-text {
  font-size: 28rpx;
  color: #1890ff;
  font-weight: bold;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .swiper {
    height: 250rpx;
  }
  
  .swiper-image {
    height: 250rpx;
  }
  
  .card-content-wrapper {
    flex-direction: column;
  }
  
  .card-image {
    width: 100%;
    height: 200rpx;
    margin-bottom: 15rpx;
  }
  
  .card-info {
    gap: 10rpx;
  }
}