/* search.wxss */
.search-container {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 5rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  height: 60rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 30rpx;
  padding: 0 30rpx;
  font-size: 24rpx;
  outline: none;
  transition: all 0.3s ease;
}

.search-input:focus {
  border-color: #1890ff;
  box-shadow: 0 0 0 2rpx rgba(24, 144, 255, 0.2);
}

.search-btn {
  margin-left: 20rpx;
  padding: 15rpx 30rpx;
  background-color: #1890ff;
  color: #fff;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: bold;
  transition: all 0.3s ease;
}

.search-btn:hover {
  background-color: #40a9ff;
}

.search-history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  margin-bottom: 15rpx;
}

.search-history-item {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #666;
  transition: all 0.3s ease;
}

.search-history-item:hover {
  background-color: #e6f7ff;
  color: #1890ff;
}

.search-history-delete {
  margin-left: 10rpx;
  font-size: 24rpx;
  font-weight: bold;
  cursor: pointer;
}

.search-history-clear {
  text-align: right;
  font-size: 20rpx;
  color: #999;
  cursor: pointer;
  transition: all 0.3s ease;
}

.search-history-clear:hover {
  color: #ff4d4f;
}

.hot-search-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.hot-search-item {
  background-color: #f5f5f5;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #666;
  transition: all 0.3s ease;
}

.hot-search-item:hover {
  background-color: #e6f7ff;
  color: #1890ff;
}

.search-results {
  padding: 0 20rpx;
}

.search-result-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.search-result-item {
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.search-result-item:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.search-result-item navigator {
  display: flex;
  padding: 20rpx;
  gap: 20rpx;
}

.search-result-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.search-result-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.search-result-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
}

.search-result-subtitle {
  font-size: 20rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.search-result-description {
  font-size: 22rpx;
  color: #666;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.search-result-empty {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200rpx;
  font-size: 24rpx;
  color: #999;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100rpx;
  font-size: 24rpx;
  color: #999;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .search-input {
    font-size: 22rpx;
    padding: 0 20rpx;
  }
  
  .search-btn {
    font-size: 22rpx;
    padding: 12rpx 25rpx;
  }
  
  .search-history-item {
    font-size: 20rpx;
    padding: 8rpx 15rpx;
  }
  
  .hot-search-item {
    font-size: 20rpx;
    padding: 8rpx 15rpx;
  }
  
  .search-result-title {
    font-size: 24rpx;
  }
  
  .search-result-subtitle {
    font-size: 18rpx;
  }
  
  .search-result-description {
    font-size: 20rpx;
  }
}