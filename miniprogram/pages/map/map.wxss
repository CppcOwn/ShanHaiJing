/* map.wxss */
.map-container {
  position: relative;
  width: 100%;
  height: 100vh;
  background-color: #0a1929;
  overflow: hidden;
}

.map-canvas {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
}

.map-control {
  position: fixed;
  bottom: 100rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  padding: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.map-control-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 0 10rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
  transition: all 0.3s ease;
}

.map-control-btn:hover {
  background-color: #e0e0e0;
  transform: scale(1.1);
}

.map-control-btn text {
  font-size: 28rpx;
}

.map-marker {
  position: absolute;
  transform: translate(-50%, -100%);
  z-index: 50;
  pointer-events: none;
}

.map-marker-icon {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  pointer-events: auto;
  cursor: pointer;
  animation: pulse 2s infinite;
}

.map-marker-icon text {
  font-size: 32rpx;
}

.map-marker-label {
  position: absolute;
  bottom: -40rpx;
  left: 50%;
  transform: translateX(-50%);
  background-color: rgba(0, 0, 0, 0.7);
  color: #fff;
  padding: 5rpx 10rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  white-space: nowrap;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: auto;
}

.map-marker:hover .map-marker-label {
  opacity: 1;
}

.loading {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background-color: rgba(0, 0, 0, 0.7);
  color: #fff;
  padding: 20rpx 40rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  z-index: 200;
}

/* 动画效果 */
@keyframes pulse {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.2);
    opacity: 0.7;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

/* 响应式设计 */
@media (max-width: 375px) {
  .map-control {
    bottom: 80rpx;
  }
  
  .map-control-btn {
    width: 50rpx;
    height: 50rpx;
    margin: 0 8rpx;
  }
  
  .map-control-btn text {
    font-size: 24rpx;
  }
  
  .map-marker-icon {
    width: 35rpx;
    height: 35rpx;
  }
  
  .map-marker-icon text {
    font-size: 28rpx;
  }
  
  .map-marker-label {
    font-size: 18rpx;
    bottom: -35rpx;
  }
}